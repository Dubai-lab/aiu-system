# Copy to .env and fill in. See README "Getting each value".
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=                 # Project Settings > API Keys (anon / publishable)
SUPABASE_SERVICE_ROLE_KEY=         # service_role / secret - NEVER expose to the browser
ANTHROPIC_API_KEY=                 # console.anthropic.com (needed from Phase 9)
ANTHROPIC_MODEL=claude-haiku-4-5
FACE_SERVICE_URL=http://127.0.0.1:8001
FACE_SERVICE_KEY=change-me         # shared secret, must equal face-service/.env
FACE_MATCH_THRESHOLD=0.45
FACE_MATCH_MARGIN=0.05
FACE_VERIFY_THRESHOLD=0.45
# Face quality rules (spec 10.3) - starting values, tune during testing
FACE_SERVICE_TIMEOUT_SECONDS=30
FACE_MIN_DET_SCORE=0.60
FACE_MIN_WIDTH_PX=110
FACE_MIN_BLUR=60
FACE_MAX_FRONTAL_YAW=12
FACE_MAX_FRONTAL_PITCH=15
FACE_MAX_TURN_YAW=40
FACE_MAX_TURN_PITCH=35
FACE_SAME_PERSON_MIN=0.50
FACE_LIVENESS_MIN_TURN_YAW=18
FACE_LIVENESS_SAME_PERSON=0.50
FACE_YAW_LEFT_SIGN=1               # +1 or -1; measured with the real webcam
ATTENDANCE_LOW_THRESHOLD=75           # % - lower attendance is highlighted in reports
EMAIL_MODE=console                 # console | smtp | relay (relay = via the Supabase Edge Function send-email, for hosts that block SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.account@gmail.com
SMTP_PASSWORD=gmail-app-password
EMAIL_FROM_NAME=AIU Administration
EMAIL_FROM_ADDRESS=your.account@gmail.com
EMAIL_RELAY_KEY=                   # only for EMAIL_MODE=relay: long random string, same as RELAY_KEY in the Edge Function
# EMAIL_RELAY_URL=                 # optional; default <SUPABASE_URL>/functions/v1/send-email
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
FORCE_PASSWORD_CHANGE_ON_FIRST_LOGIN=false
UNIVERSITY_NAME=AIU
